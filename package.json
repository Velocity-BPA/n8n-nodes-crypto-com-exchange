{
  "name": "@velocity-bpa/n8n-nodes-crypto-com-exchange",
  "version": "1.0.0",
  "description": "n8n community node for Crypto.com Exchange API integration",
  "keywords": [
    "n8n-community-node-package",
    "crypto.com",
    "cryptocurrency",
    "exchange",
    "trading"
  ],
  "license": "bsl-catalog",
  "homepage": "https://github.com/velocity-bpa/n8n-nodes-crypto-com-exchange",
  "author": {
    "name": "Velocity BPA",
    "email": "support@velocity-bpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/velocity-bpa/n8n-nodes-crypto-com-exchange.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CryptocomExchangeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CryptocomExchange/CryptocomExchange.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.15.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.1.0",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "crypto": "^1.0.1"
  }
}